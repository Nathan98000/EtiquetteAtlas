{
	"name": "etiquette-atlas-site",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node scripts/serve-pages.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:build": "node scripts/check-build.js",
		"check:content": "node scripts/check-content.js",
		"check:deployed": "node scripts/check-deployed.js",
		"cards": "CARDS=on vite build && svelte-kit sync && node scripts/share-images.js",
		"cards:docker": "CARDS=on vite build && svelte-kit sync && sh scripts/in-docker.sh node scripts/share-images.js",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:deployed": "BEACON=live DEPLOYED_ORIGIN=https://nathan98000.github.io playwright test --project=chromium e2e/analytics.e2e.ts",
		"test:visual": "sh scripts/in-docker.sh sh -c \"VISUAL=1 npx playwright test\"",
		"test:visual:update": "sh scripts/in-docker.sh sh -c \"VISUAL=1 npx playwright test --update-snapshots\"",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"lhci": "lhci autorun --config=lighthouserc.cjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3-array": "3.2.2",
		"@types/d3-geo": "3.1.1",
		"@types/d3-scale": "4.0.9",
		"@types/node": "^24",
		"@types/topojson-client": "3.1.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"d3-array": "3.2.4",
		"d3-geo": "3.1.1",
		"d3-scale": "4.0.2",
		"topojson-client": "3.1.0",
		"world-atlas": "2.0.2"
	}
}
